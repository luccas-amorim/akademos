{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sigla": {
      "type": "string",
      "minLength": 2,
      "maxLength": 12
    },
    "nome": {
      "type": "string",
      "minLength": 3
    },
    "sistema": {
      "type": "string",
      "enum": [
        "sigaa",
        "jupiter",
        "outro"
      ]
    },
    "escala": {
      "type": "string",
      "description": "id da escala em escala.yaml"
    },
    "creditos_max_semestre": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "grade": {
      "type": "object",
      "properties": {
        "dias": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "seg",
              "ter",
              "qua",
              "qui",
              "sex",
              "sab"
            ]
          }
        },
        "faixas": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "inicio": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              },
              "fim": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              }
            },
            "required": [
              "inicio",
              "fim"
            ]
          }
        }
      },
      "required": [
        "dias",
        "faixas"
      ]
    },
    "ficticia": {
      "description": "dados de demonstração, sem relação com instituição real",
      "type": "boolean"
    }
  },
  "required": [
    "sigla",
    "nome",
    "sistema",
    "escala",
    "creditos_max_semestre",
    "grade"
  ],
  "additionalProperties": false
}
