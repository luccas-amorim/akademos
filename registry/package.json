{
  "name": "@akademos/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pacotes declarativos de instituições: matrizes, escalas e modelos de histórico.",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema": "tsx src/cli/gerar-schema.ts",
    "validate": "tsx src/cli/validar.ts"
  },
  "dependencies": {
    "@akademos/core": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
